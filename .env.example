# Copie para .env (cp .env.example .env). Todos os valores ja tem um default
# no docker-compose.yml, entao o ambiente local sobe mesmo sem este arquivo.

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=togglemaster
POSTGRES_PASSWORD=togglemaster

# ---------------------------------------------------------------- auth-service
# Chave mestra usada para criar novas chaves de API (POST /admin/keys)
MASTER_KEY=admin-secreto-123

# Chave de servico que o evaluation-service usa para chamar o flag-service e o
# targeting-service. No ambiente local ela ja vem pre-cadastrada no banco
# (infra/postgres/auth-02-seed-dev-key.sql). NAO use este valor em producao.
SERVICE_API_KEY=tm_key_local_dev_0000000000000000

# ---------------------------------------------------------------------- AWS
# Local: credenciais fake, pois SQS e DynamoDB sao emulados por containers.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# Endpoints locais. Para apontar os servicos para a AWS real, basta esvaziar
# AWS_SQS_ENDPOINT / AWS_DYNAMODB_ENDPOINT e preencher AWS_SQS_URL com a URL
# da fila real + credenciais validas.
AWS_SQS_URL=http://elasticmq:9324/queue/togglemaster-events
AWS_SQS_ENDPOINT=http://elasticmq:9324
AWS_DYNAMODB_ENDPOINT=http://dynamodb-local:8000
